---
import { siteConfig } from '../config';
import { story } from '../chapters';
import { projects, otherProjects } from '../journey';
import '../styles/journey.css';
const arrow = 'M4 15 15 4M5 4h10v10';
---
<!doctype html>
<html lang="en" data-type="software" data-motion data-radius="sharp" data-buttons="solid">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="description" content="Valentino Guerrini — hardware acceleration, computer architecture and reconfigurable computing. From Piacenza to Milan, Chicago and Zürich." />
 <meta name="theme-color" content="#f5f3ed" />
 <meta name="page-type" content="software"/><meta name="site-kind" content="tech"/>
 <meta property="og:title" content="Valentino Guerrini — An engineer’s journey" />
 <meta property="og:description" content="Hardware acceleration. Computer architecture. A personal journey." />
 <meta property="og:image" content="https://valentinoguerrini.github.io/assets/journey-banner.webp" />
 <link rel="canonical" href="https://valentinoguerrini.github.io/" />
 <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet" />
 <link rel="stylesheet" href="/assets/motion/motion.css" />
 <title>Valentino Guerrini — An engineer’s journey</title>
</head>
<body>
 <a class="skip" href="#index" data-open-index>Skip to chapter and project index</a>
 <header class="site-header"><a class="signature" href="#beginning" data-go="0">Valentino Guerrini<span aria-hidden="true">.</span></a><button class="index-toggle" data-open-index aria-haspopup="dialog">Index <span class="index-icon" aria-hidden="true"><i></i><i></i></span></button></header>
 <main id="journey" aria-label="An engineer’s journey">
  <div class="experience">
   <div class="journey-layout">
    <div class="map-column">
     <p class="map-kicker"><span class="live-dot"></span> A journey in four places</p>
     <div class="map-surface" id="map-surface">
      <svg class="route-map" viewBox="0 0 420 760" preserveAspectRatio="none" aria-hidden="true">
       <path class="route-base" id="route" d="M150 50 C105 60 95 72 130 112 C175 170 315 152 282 257 C260 330 100 310 135 421 C165 500 320 492 270 589 C245 642 145 642 175 720"/>
       <path class="route-travelled" id="route-travelled" d="M150 50 C105 60 95 72 130 112 C175 170 315 152 282 257 C260 330 100 310 135 421 C165 500 320 492 270 589 C245 642 145 642 175 720"/>
       {[{x:130,y:112},{x:282,y:257},{x:135,y:421},{x:270,y:589}].map((p,i)=><g class="route-node" data-node={i+1}><circle cx={p.x} cy={p.y} r="8"/><circle class="node-center" cx={p.x} cy={p.y} r="2.5"/></g>)}
       <circle class="route-endpoint" cx="150" cy="50" r="3"/><circle class="route-endpoint" cx="175" cy="720" r="3"/>
      </svg>
      <div class="scene" id="scene" aria-hidden="true"></div>
      <div class="fallback-traveller" id="fallback-traveller" aria-hidden="true"><span></span><i></i></div>
      <nav class="map-stops" aria-label="Places on the journey">
       {[{x:55,y:22.7},{x:38,y:42.3},{x:57,y:63.9},{x:35,y:85.3}].map((p,i)=><a class="map-stop" href={`#${story[i+1].id}`} data-go={i+1} data-map-stop={i+1} style={`left:${p.x}%;top:${p.y}%`}><span>{story[i+1].label}</span><small>{story[i+1].number}</small></a>)}
      </nav>
     </div>
    </div>
    <div class="deck-column">
     <div class="deck-heading"><p id="stop-name">The journey</p><span id="stop-date">Piacenza → Zürich</span></div>
     <div class="decks">
      {story.map((stop,i)=><section id={stop.id} class:list={['chapter',{'is-active':i===0}]} data-chapter={i} aria-label={stop.label}>
       <h2 class="reading-heading">{stop.label} <span>{stop.date}</span></h2>
       <div class="card-stack">
        {stop.cards.map((card,j)=><article class="journey-card" data-card={j} aria-label={`${stop.label}: ${card.title}`}>
         <div class="card-top"><p class="eyebrow">{card.label}</p><span class="card-number" aria-hidden="true">{String(j+1).padStart(2,'0')}</span></div>
         {i===0 ? <h1>{card.title}</h1> : <h2>{card.title}</h2>}
         <p class="card-copy">{card.text}</p>
         <div class="card-bottom"><p class="card-footnote">{card.footnote}</p>
          {card.link && <a class="card-action" href={card.link} target={card.link.startsWith('mailto:')?undefined:'_blank'} rel="noopener noreferrer">{card.linkLabel}<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a>}
          {card.detail!==undefined && <button class="card-action" data-detail={card.detail} aria-haspopup="dialog">{i===0?'About me':'More about the work'}<span aria-hidden="true">+</span></button>}
          {i===5 && <div class="contact-links"><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></div>}
         </div>
        </article>)}
       </div>
      </section>)}
     </div>
     <div class="deck-navigation">
      <div class="deck-pagination"><span id="card-counter">01 / 01</span><div id="card-dots" aria-label="Cards at this stop">{story.map((stop,i)=><div data-dots={i} hidden={i!==0}>{stop.cards.map((_,j)=><button data-card-go={`${i}:${j}`} aria-label={`${stop.label}, card ${j+1}`} aria-current={j===0?'step':undefined}><span></span></button>)}</div>)}</div></div>
      <div class="deck-arrows"><button id="previous-card" aria-label="Previous card" disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m6-6-6 6 6 6"/></svg></button><button id="next-card" aria-label="Next card"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-6-6 6 6-6 6"/></svg></button></div>
     </div>
     <p class="scroll-guide"><span id="scroll-guide">Scroll to start the journey</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v14M4 11l6 6 6-6"/></svg></p>
    </div>
   </div>
   <footer class="experience-footer"><span id="route-status">An engineer’s journey</span><span>Based in Zürich</span></footer>
   <div class="progress" aria-hidden="true"><span></span></div>
  </div>
 </main>
 <dialog id="index" aria-labelledby="index-title"><div class="dialog-shell">
  <div class="dialog-header"><h2 id="index-title">Index</h2><button class="close" data-close aria-label="Close index">×</button></div>
  <nav class="index-chapters" aria-label="Jump to a chapter">{story.map((c,i)=><a href={`#${c.id}`} data-go={i}><span>{c.number}</span>{c.label}<span aria-hidden="true">↗</span></a>)}</nav>
  <div class="index-work"><p class="eyebrow">Selected work</p><button data-detail="2">FPGA & cryptography <span>+</span></button><button data-detail="3">HPC & Allreduce <span>+</span></button><button data-detail="6">Other projects <span>+</span></button></div>
  <div class="index-bottom"><button id="motion-toggle" aria-pressed="false">Motion on</button><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></div>
 </div></dialog>
 <dialog id="details" aria-labelledby="details-title"><div class="dialog-shell details-shell">
  <div class="dialog-header"><p class="eyebrow" id="details-label">About</p><button class="close" data-close aria-label="Close details">×</button></div>
  <h2 id="details-title">Valentino Guerrini</h2>
  <div data-detail-panel="0"><p>I’m an Italian computer engineer based in Zürich, working on hardware acceleration. My interests span digital design, computer architecture and reconfigurable computing.</p><p>I completed a double degree at Politecnico di Milano and the University of Illinois Chicago, alongside the Alta Scuola Politecnica programme.</p><dl><div><dt>At the workbench</dt><dd>C / C++, Verilog, Vivado, Vitis, MPI</dd></div><div><dt>Outside work</dt><dd>Mountains, running and good company.</dd></div></dl><a class="detail-link" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">View my LinkedIn profile<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></div>
  <div data-detail-panel="1"><p>My journey starts around Piacenza, in northern Italy. It’s still home, even as university and research have taken me to Milan, Chicago and Zürich.</p><p>This site follows that route: the places I’ve lived, the problems I’ve worked on, and what I’m building now.</p><button class="detail-link" data-go="2">Continue to Milan<span aria-hidden="true">→</span></button></div>
  <div data-detail-panel="2"><p>At Politecnico di Milano and NECSTLab, I worked on FPGA architectures for homomorphic encryption and quantum error correction. I also explored embedded cryptography as a research intern at STMicroelectronics.</p><p class="detail-note">BSc 2023 · MSc 2026 · Alta Scuola Politecnica</p>{projects.filter(p=>p.type==='hardware').map(p=><article class="detail-project"><p class="eyebrow">{p.fact}</p><h3>{p.short}</h3><p>{p.description}</p><a class="detail-link" href={p.link} target="_blank" rel="noopener noreferrer">View project<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></article>)}<a class="detail-link publication-link" href="https://ieeexplore.ieee.org/abstract/document/10596535" target="_blank" rel="noopener noreferrer">Read the RAW 2024 paper<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></div>
  <div data-detail-panel="3"><p>My double degree took me to the University of Illinois Chicago, where I researched communication algorithms for high-performance computing.</p><article class="detail-project"><p class="eyebrow">MS Computer Science · 2025</p><h3>Configurable hierarchical Allreduce</h3><p>{projects[1].description}</p><p class="detail-note">C / C++ · MPI · Polaris · Aurora</p><a class="detail-link" href={projects[1].link} target="_blank" rel="noopener noreferrer">View the Allreduce project<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></article></div>
  <div data-detail-panel="4"><p>I work on hardware accelerators for server SoCs at Huawei Research Center in Zürich. My focus is on computer architecture and efficient computation.</p><p>Beyond work, I’m drawn to the mountains, skiing, running and time with friends. Switzerland makes a pretty good base for that.</p><a class="detail-link" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">View my experience<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></div>
  <div data-detail-panel="6">{otherProjects.map(p=><article class="detail-project"><p class="eyebrow">{p.category}</p><h3>{p.name}</h3><p>{p.description}</p><a class="detail-link" href={p.link} target="_blank" rel="noopener noreferrer">View project<svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></article>)}</div>
 </div></dialog>
 <noscript><style>.card-action[data-detail]{display:none}.index-toggle{display:none}</style><div class="no-js-links"><a href={siteConfig.social.github}>Projects on GitHub</a><a href={siteConfig.social.linkedin}>Experience on LinkedIn</a></div></noscript>
 <script>import '../scripts/journey';</script>
 <script is:inline type="module" src="/assets/motion/motion.js"></script>
</body>
</html>
