---
import { siteConfig } from '../config';
import { chapters, projects, otherProjects } from '../journey';
import Traveler from '../components/Traveler.astro';
import ProjectArt from '../components/ProjectArt.astro';
import '../styles/journey.css';
---
<!doctype html>
<html lang="en" data-type="software" data-motion data-radius="sharp" data-buttons="solid">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="description" content="Valentino Guerrini — hardware accelerators, computer architecture and reconfigurable computing. A journey from Piacenza to Milan, Chicago and Zürich." />
 <meta name="page-type" content="software"/><meta name="site-kind" content="tech"/>
 <meta name="theme-color" content="#f3eddf" />
 <meta property="og:title" content="Valentino Guerrini — An engineer’s journey" />
 <meta property="og:description" content="From Italian hills to computer architecture. Follow my journey through Milan, Chicago and Zürich." />
 <meta property="og:image" content="https://valentinoguerrini.github.io/assets/journey-banner.webp" />
 <link rel="canonical" href="https://valentinoguerrini.github.io/" />
 <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
 <link rel="preload" href="/assets/journey-panorama.webp" as="image" />
 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
 <link rel="stylesheet" href="/assets/motion/motion.css" />
 <title>Valentino Guerrini — An engineer’s journey</title>
</head>
<body>
 <!-- Visual direction: user's painted travel-poster reference; paper, teal and ochre. The continuous character journey intentionally replaces the generic section recipe. -->
 <a class="skip" href="#work">Skip to selected work</a>
 <header class="nav"><div class="wrap nav-inner">
  <a href="#top" class="wordmark" aria-label="Valentino Guerrini, back to beginning">vg<span>.</span></a>
  <span class="nav-note">An engineer’s journey</span>
  <nav aria-label="Main navigation"><a href="#journey" data-go="1">Journey</a><a href="#work">Work</a><a href="#about">About</a><a href="#contact" class="contact-link">Say hello <svg class="out-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4M4 4h12v12"/></svg></a></nav>
 </div></header>
 <main id="top">
  <section id="journey" class="journey" aria-label="My journey" data-big-scene>
   <div class="journey-stage">
    <div class="story-copy wrap">
     {chapters.map((ch,i)=><article class:list={['chapter',{'is-active':i===0}]} id={ch.id} data-chapter={i}>
       <div class="chapter-heading"><p class="eyebrow"><span>{ch.number} /</span> {ch.date}</p>{i===0 ? <h1>{ch.title}<br/><em>{ch.emphasis}</em></h1> : <h2>{ch.title}<br/><em>{ch.emphasis}</em></h2>}</div>
       <div class="chapter-info"><p class="location"><span class="location-dot"/>{ch.place}</p><p class="story-description">{ch.description}</p><p class="chapter-detail">{ch.detail}</p>{i===0 && <a class="text-link start-link" href="#piacenza" data-go="1">Follow my journey <span aria-hidden="true">↓</span></a>}</div>
      </article>)}
    </div>
    <div class="landscape" aria-hidden="true">
     <div class="world"><img src="/assets/journey-panorama.webp" alt="" width="2172" height="724" fetchpriority="high" decoding="async" /></div>
     <div class="traveler"><span class="traveler-label">That’s me.</span><Traveler/></div>
     <div class="scene-corner">A few places. One continuing story.</div>
    </div>
    <div class="journey-bottom wrap">
     <span class="scroll-hint"><span aria-hidden="true">↓</span> Scroll to travel</span>
     <nav class="route-nav" aria-label="Journey chapters">{chapters.slice(1).map((ch,i)=><a href={`#${ch.id}`} data-go={i+1}><span class="route-dot"/><span>{['Piacenza','Milan','Chicago','Zürich'][i]}</span></a>)}</nav>
     <button type="button" id="motion-toggle" aria-pressed="false" title="Switch to a static, readable journey">Motion on</button>
    </div>
    <div class="journey-progress" aria-hidden="true"><span/></div>
   </div>
  </section>
  <section id="work" class="work-section">
   <div class="wrap">
    <div class="section-head"><div><p class="eyebrow">01 / Selected work</p><h2>Ideas, built<br/><em>into systems.</em></h2></div><p>From encrypted data to supercomputers.<br/>A few things I’ve spent my time on.</p></div>
    <div class="work-filters" aria-label="Filter projects"><button data-filter="all" aria-pressed="true">All work <span>03</span></button><button data-filter="hardware" aria-pressed="false">Hardware</button><button data-filter="systems" aria-pressed="false">Systems</button></div>
    <div class="project-list">{projects.map(project=><article class="project" id={project.id} data-category={project.type}>
      <div class="project-picture"><span class="project-number">{project.number} /</span><ProjectArt kind={project.art}/><span class="project-category">{project.category}</span></div>
      <div class="project-copy"><p class="eyebrow">{project.short}</p><h3>{project.name}</h3><p>{project.description}</p><p class="project-fact">{project.fact}</p><p class="project-stack">{project.stack}</p><a class="text-link" href={project.link} target="_blank" rel="noopener noreferrer">{project.linkLabel}<svg class="out-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4M4 4h12v12"/></svg></a></div>
     </article>)}</div>
    <div class="other-work"><h3>Other explorations</h3>{otherProjects.map(p=><a href={p.link} target="_blank" rel="noopener noreferrer"><span><strong>{p.name}</strong><small>{p.description}</small></span><span class="other-category">{p.category}</span><svg class="out-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4M4 4h12v12"/></svg></a>)}</div>
   </div>
  </section>
  <section id="about" class="about-section"><div class="wrap">
   <p class="eyebrow">02 / The person behind the projects</p>
   <div class="about-grid"><div><h2>Curious about<br/><em>what’s underneath.</em></h2><p class="about-intro">I’m an Italian computer engineer based in Zürich. I like understanding how systems work, and finding ways to make them work better.</p><p>My work sits between algorithms and the hardware that runs them: digital design, computer architecture and reconfigurable computing. Away from a screen, there are mountains, a pair of skis, a run, or a table full of friends.</p><a class="text-link" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">Find me on LinkedIn <svg class="out-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4M4 4h12v12"/></svg></a></div>
    <div class="field-notes"><p class="eyebrow">A few field notes</p><dl><div><dt>Based in</dt><dd>Zürich, Switzerland</dd></div><div><dt>Currently</dt><dd>Hardware acceleration<br/>Huawei Research Center</dd></div><div><dt>Education</dt><dd>Politecnico di Milano<br/>University of Illinois Chicago<br/>Alta Scuola Politecnica</dd></div><div><dt>At the workbench</dt><dd>C / C++ · Verilog<br/>Vivado · Vitis · MPI</dd></div><div><dt>Beyond the workbench</dt><dd>Mountains. Running. Good company.</dd></div></dl></div>
   </div>
   <div class="publication"><p class="eyebrow">Research in print · RAW / IPDPS Workshops 2024</p><a href="https://ieeexplore.ieee.org/abstract/document/10596535" target="_blank" rel="noopener noreferrer">Towards the Acceleration of the Sparse Blossom Algorithm for Quantum Error Correction <svg class="out-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4M4 4h12v12"/></svg></a></div>
  </div></section>
 </main>
 <footer id="contact" class="closing"><div class="wrap">
  <div class="footer-top"><p class="eyebrow">03 / The next stop</p><h2>Good things start<br/><em>with a conversation.</em></h2><a class="btn btn--primary" href={`mailto:${siteConfig.social.email}`}>Say hello <svg class="out-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4M4 4h12v12"/></svg></a></div>
  <div class="footer-bottom"><a class="wordmark" href="#top">vg<span>.</span></a><p>Valentino Guerrini · Zürich</p><div><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="#top">Back to the start ↑</a></div><span>© {new Date().getFullYear()}</span></div>
 </div></footer>
 <script>import '../scripts/journey';</script>
 <script is:inline type="module" src="/assets/motion/motion.js"></script>
</body>
</html>
